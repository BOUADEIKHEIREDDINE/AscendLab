# Copy to .env.local and fill in. Values come from the Firebase console
# (Project settings > Your apps). The Android values are in ../app/google-services.json.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=ascendlab-def55.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=ascendlab-def55
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=ascendlab-def55.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in: the "Web client" OAuth id (client_type 3 in google-services.json).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only: CLIENT_ID from GoogleService-Info.plist (also set REVERSED_CLIENT_ID via that file).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# true = use the local Firebase Emulator Suite (firebase emulators:start) instead of the real project.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
# EXPO_PUBLIC_EMULATOR_HOST=192.168.1.20   # your computer's LAN IP when testing on a real phone
